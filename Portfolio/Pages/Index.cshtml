@page "/{lang:regex(^(en|ru)$)?}"
@model IndexModel
@{
    var p = Model.Profile;
    var ui = Model.Ui;
    ViewData["Title"] = "sozakbay.asia";
    ViewData["Description"] = p.Summary;
    ViewData["Lang"] = ui.Lang;
    var sectionNo = 0;
    string Num() => (++sectionNo).ToString("00") + ".";
}

@functions {
    static Microsoft.AspNetCore.Html.HtmlString Icon(string name) => new(name switch
    {
        "telegram" => """<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.9 4.3 18.7 19.4c-.2 1-.9 1.3-1.7.8l-4.8-3.5-2.3 2.2c-.3.3-.5.5-1 .5l.3-4.9 8.9-8c.4-.3-.1-.5-.6-.2L6.5 13.2 1.8 11.7c-1-.3-1-1 .2-1.5L20.6 3c.8-.3 1.6.2 1.3 1.3z"/></svg>""",
        "mail" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>""",
        "whatsapp" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3z"/><path d="M9 8.5c0 3.5 3 6.5 6.5 6.5l1-1.6-2-1-.9.8a4.5 4.5 0 0 1-2.3-2.3l.8-.9-1-2z" fill="currentColor" stroke-width="1"/></svg>""",
        "phone" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>""",
        "api" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m8 9-4 3 4 3M16 9l4 3-4 3M13.5 6l-3 12"/></svg>""",
        "db" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><ellipse cx="12" cy="6" rx="7" ry="3"/><path d="M5 6v12c0 1.7 3.1 3 7 3s7-1.3 7-3V6M5 12c0 1.7 3.1 3 7 3s7-1.3 7-3"/></svg>""",
        "bolt" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M13 3 5 14h6l-1 7 8-11h-6z"/></svg>""",
        "check" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="m5 12 5 5 9-10"/></svg>""",
        "cert" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="9" r="5"/><path d="m9 13-1.5 8L12 18.5 16.5 21 15 13"/></svg>""",
        "arrow" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"/></svg>""",
        "github" => """<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"/></svg>""",
        "linkedin" => """<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>""",
        "download" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"/></svg>""",
        "sun" => """<svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>""",
        "moon" => """<svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg>""",
        "powershell" => """<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4h15.5a1 1 0 0 1 1 1.2l-2.6 13.6a1.5 1.5 0 0 1-1.5 1.2H2.9a1 1 0 0 1-1-1.2L4.5 5.2A1.5 1.5 0 0 1 6 4z" fill="#2671be"/><path d="m7.5 8.5 4.5 3.5-5.5 3.5M12.5 15.5h4" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>""",
        "win-min" => """<svg viewBox="0 0 10 10" aria-hidden="true"><path d="M0 5h10" stroke="currentColor" stroke-width="1"/></svg>""",
        "win-max" => """<svg viewBox="0 0 10 10" aria-hidden="true"><rect x=".5" y=".5" width="9" height="9" fill="none" stroke="currentColor" stroke-width="1"/></svg>""",
        "win-close" => """<svg viewBox="0 0 10 10" aria-hidden="true"><path d="m0 0 10 10M10 0 0 10" stroke="currentColor" stroke-width="1"/></svg>""",
        _ => ""
    });
}

<header class="nav">
    <div class="container nav-inner">
        <a class="logo" href="#home"><span class="accent">&gt;_</span> @p.ShortName.ToLowerInvariant()</a>
        <nav class="nav-links" aria-label="@ui.NavAria">
            <a href="#home" class="active">~/home</a>
            <a href="#stack">~/stack</a>
            <a href="#experience">~/experience</a>
            <a href="#contact">~/contact</a>
        </nav>
        <div class="lang-switch" role="group" aria-label="Language">
            <a href="/" lang="ru" class="@(ui.Lang == "ru" ? "active" : null)" aria-current="@(ui.Lang == "ru" ? "page" : null)">RU</a>
            <a href="/en" lang="en" class="@(ui.Lang == "en" ? "active" : null)" aria-current="@(ui.Lang == "en" ? "page" : null)">EN</a>
        </div>
        <button type="button" class="theme-toggle" id="theme-toggle" aria-label="@ui.ThemeToggle" title="@ui.ThemeToggle">@Icon("sun")@Icon("moon")</button>
    </div>
</header>

<main>
    <section class="hero" id="home">
        <div class="container hero-grid">
            <div class="hero-text reveal">
                <span class="status"><span class="dot"></span> open to work</span>
                <h1>
                    <span class="kw">var</span> <span class="muted-strong">developer</span> <span class="kw">=</span><br />
                    <span class="str">"@p.ShortName"</span><span class="kw">;</span>
                </h1>
                <p class="role"><span class="comment">//</span> @p.Role · @p.Tagline</p>
                <p class="lead">@p.Summary</p>
                <div class="hero-actions">
                    <a class="btn btn-primary" href="@ProfileData.CvPath" download>@Icon("download") @ui.DownloadCv <span class="btn-note">PDF</span></a>
                    <a class="btn btn-ghost" href="#experience">$ view --experience</a>
                </div>
                <div class="socials">
                    <a href="@p.Contacts.GitHubUrl" target="_blank" rel="noopener" aria-label="GitHub">@Icon("github")</a>
                    <a href="@p.Contacts.LinkedInUrl" target="_blank" rel="noopener" aria-label="LinkedIn">@Icon("linkedin")</a>
                    <a href="@p.Contacts.TelegramUrl" target="_blank" rel="noopener" aria-label="Telegram">@Icon("telegram")</a>
                    <a href="@p.Contacts.WhatsAppUrl" target="_blank" rel="noopener" aria-label="WhatsApp">@Icon("whatsapp")</a>
                    <a href="mailto:@p.Contacts.Email" aria-label="Email">@Icon("mail")</a>
                    <a href="@p.Contacts.PhoneUrl" aria-label="@ui.Phone">@Icon("phone")</a>
                </div>
            </div>

            <div class="terminal ps reveal">
                <div class="term-bar">
                    <span class="term-tab">@Icon("powershell") Windows PowerShell</span>
                    <span class="win-controls" aria-hidden="true"><span>@Icon("win-min")</span><span>@Icon("win-max")</span><span class="close">@Icon("win-close")</span></span>
                </div>
                <pre class="term-body" id="about-xml"><span class="d">&lt;?xml version="1.0" encoding="UTF-8"?&gt;</span>
<span class="k">&lt;developer&gt;</span>
  <span class="k">&lt;name&gt;</span><span class="s">@p.FullName</span><span class="k">&lt;/name&gt;</span>
  <span class="k">&lt;role&gt;</span><span class="s">@p.Role</span><span class="k">&lt;/role&gt;</span>
  <span class="k">&lt;location&gt;</span><span class="s">@p.Location</span><span class="k">&lt;/location&gt;</span>
  <span class="k">&lt;experience&gt;</span><span class="s">@p.Experience[0].Duration</span><span class="k">&lt;/experience&gt;</span>
  <span class="k">&lt;skills&gt;</span>
    <span class="k">&lt;skill&gt;</span><span class="s">C#</span><span class="k">&lt;/skill&gt;</span> <span class="k">&lt;skill&gt;</span><span class="s">.NET</span><span class="k">&lt;/skill&gt;</span>
    <span class="k">&lt;skill&gt;</span><span class="s">PostgreSQL</span><span class="k">&lt;/skill&gt;</span> <span class="k">&lt;skill&gt;</span><span class="s">MS SQL</span><span class="k">&lt;/skill&gt;</span>
    <span class="k">&lt;skill&gt;</span><span class="s">Kafka</span><span class="k">&lt;/skill&gt;</span> <span class="k">&lt;skill&gt;</span><span class="s">Docker</span><span class="k">&lt;/skill&gt;</span>
  <span class="k">&lt;/skills&gt;</span>
<span class="k">&lt;/developer&gt;</span>

<span class="prompt">PS C:\Users\Yeldos&gt;</span> <span class="cursor">_</span></pre>
            </div>
        </div>
        <a class="scroll-hint" href="#stats" aria-label="@ui.ScrollDown">@Icon("arrow")</a>
    </section>

    <section class="stats" id="stats">
        <div class="container stats-grid">
            @foreach (var s in p.Stats)
            {
                <div class="stat reveal">
                    <div class="stat-value">@s.Value</div>
                    <div class="stat-label">@s.Label</div>
                </div>
            }
        </div>
    </section>

    <section class="section" id="stack">
        <div class="container">
            <h2 class="section-title"><span class="num">@Num()</span> @ui.SectionStack</h2>
            <div class="grid-3">
                @foreach (var g in p.SkillGroups)
                {
                    <div class="card reveal">
                        <h3 class="card-label"><span class="bullet @g.Dot"></span>@g.Title</h3>
                        <div class="chips">
                            @foreach (var s in g.Items)
                            {
                                <span class="chip"><span class="chip-badge" style="--c:@s.Color">@s.Badge</span>@s.Name</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="section" id="expertise">
        <div class="container">
            <h2 class="section-title"><span class="num">@Num()</span> @ui.SectionExpertise</h2>
            <div class="grid-3">
                @foreach (var e in p.Expertise)
                {
                    <article class="card project reveal">
                        <div class="project-head">
                            <span class="project-name">@Icon(e.Icon) @e.Title</span>
                            <span class="project-tag">@e.Tag</span>
                        </div>
                        <p class="card-text">@e.Description</p>
                        <div class="tags">
                            @foreach (var t in e.Tags)
                            {
                                <span class="tag">@t</span>
                            }
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>

    <section class="section" id="experience">
        <div class="container">
            <h2 class="section-title"><span class="num">@Num()</span> @ui.SectionExperience</h2>
            <ol class="timeline">
                @foreach (var j in p.Experience)
                {
                    <li class="timeline-item reveal">
                        <div class="timeline-head">
                            <h3>
                                @j.Title <span class="at">@@</span>
                                <a href="@j.CompanyUrl" target="_blank" rel="noopener" class="company">@j.Company</a>
                            </h3>
                            <span class="period">@j.Period · @j.Duration</span>
                        </div>
                        <p class="card-text">@j.Description</p>
                        <ul class="highlights">
                            @foreach (var h in j.Highlights)
                            {
                                <li>@h</li>
                            }
                        </ul>
                        <div class="tags">
                            @foreach (var t in j.Tags)
                            {
                                <span class="tag">@t</span>
                            }
                        </div>
                    </li>
                }
            </ol>
        </div>
    </section>

    <section class="section" id="education">
        <div class="container">
            <h2 class="section-title"><span class="num">@Num()</span> @ui.SectionEducation</h2>
            <div class="edu-grid">
                <div class="card reveal">
                    <div class="card-cmd">$ git log --education</div>
                    <ul class="edu-list">
                        @foreach (var ed in p.Education)
                        {
                            <li>
                                <span class="edu-year">@ed.Year</span>
                                <div>
                                    <div class="edu-degree">@ed.Degree</div>
                                    <div class="edu-inst">@ed.Institution</div>
                                    <div class="edu-details">@ed.Details</div>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
                <div class="card reveal">
                    <div class="card-cmd">$ ls ./certificates</div>
                    <ul class="activity">
                        @foreach (var c in p.Certificates)
                        {
                            <li>
                                <span class="activity-icon">@Icon("cert")</span>
                                <div>
                                    <div class="activity-title">@c.Issuer @c.Title</div>
                                    <div class="activity-text">@ui.DigitalCertificate · @c.Year</div>
                                </div>
                            </li>
                        }
                        <li>
                            <span class="activity-icon ok">@Icon("check")</span>
                            <div>
                                <div class="activity-title">@ui.DegreeTitle</div>
                                <div class="activity-text">@ui.DegreeText</div>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <section class="section" id="principles">
        <div class="container">
            <h2 class="section-title"><span class="num">@Num()</span> @ui.SectionPrinciples</h2>
            <div class="grid-3">
                @foreach (var pr in p.Principles)
                {
                    <figure class="card quote reveal">
                        <div class="quote-mark">“</div>
                        <blockquote class="card-text">@pr.Text</blockquote>
                        <figcaption>
                            <span class="avatar" style="--c:@pr.Color">@pr.Initials</span>
                            <span>
                                <span class="quote-name">@pr.Title</span>
                                <span class="quote-role">Clean Code · SOLID · Agile/Scrum</span>
                            </span>
                        </figcaption>
                    </figure>
                }
            </div>
        </div>
    </section>

    <section class="section" id="languages">
        <div class="container">
            <h2 class="section-title"><span class="num">@Num()</span> @ui.SectionLanguages</h2>
            <div class="grid-3">
                @foreach (var l in p.Languages)
                {
                    <article class="card lang reveal">
                        <span class="pill">@l.Code</span>
                        <h3 class="lang-name">@l.Name</h3>
                        <p class="card-text">@l.Level</p>
                        <div class="meter" role="meter" aria-valuenow="@l.Percent" aria-valuemin="0" aria-valuemax="100" aria-label="@l.Name">
                            <span style="width:@(l.Percent)%"></span>
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>

    <section class="section contact" id="contact">
        <div class="container">
            <div class="terminal contact-card reveal">
                <div class="term-bar">
                    <span class="term-tab">@Icon("powershell") contact.ps1</span>
                    <span class="win-controls" aria-hidden="true"><span>@Icon("win-min")</span><span>@Icon("win-max")</span><span class="close">@Icon("win-close")</span></span>
                </div>
                <div class="contact-body">
                    <h2><span class="accent">&gt;</span> @ui.ContactTitle</h2>
                    <p class="card-text">@p.WorkPreferences</p>
                    <ul class="contact-list">
                        <li><span class="k">phone</span> <a href="@p.Contacts.PhoneUrl">@p.Contacts.Phone</a> <span class="muted">@ui.PreferredContact</span></li>
                        <li><span class="k">telegram</span> <a href="@p.Contacts.TelegramUrl" target="_blank" rel="noopener">@p.Contacts.Telegram</a></li>
                        <li><span class="k">email</span> <a href="mailto:@p.Contacts.Email">@p.Contacts.Email</a></li>
                        <li><span class="k">github</span> <a href="@p.Contacts.GitHubUrl" target="_blank" rel="noopener">@Contacts.Display(p.Contacts.GitHubUrl)</a></li>
                        <li><span class="k">linkedin</span> <a href="@p.Contacts.LinkedInUrl" target="_blank" rel="noopener">@Contacts.Display(p.Contacts.LinkedInUrl)</a></li>
                    </ul>
                    <div class="hero-actions contact-actions">
                        <a class="btn btn-primary" href="@p.Contacts.TelegramUrl" target="_blank" rel="noopener">$ send --message</a>
                        <a class="btn btn-ghost" href="@ProfileData.CvPath" download>@Icon("download") @ui.DownloadCv</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>

<footer class="footer">
    <div class="container">
        <span class="accent">&gt;_</span> @p.ShortName.ToLowerInvariant() — built with C# &amp; ASP.NET Core · @DateTime.Now.Year
    </div>
</footer>

@page "/{lang:regex(^(en|ru)$)?}"
@model IndexModel
@{
    var p = Model.Profile;
    var ui = Model.Ui;
    ViewData["Title"] = "sozakbay.dev";
    ViewData["Description"] = p.Summary;
    ViewData["Lang"] = ui.Lang;
    ViewData["Path"] = ui.Lang == "en" ? "/en" : "/";
    ViewData["OgTitle"] = $"{ProfileData.DisplayName} — {p.Role}";
}

@functions {
    static Microsoft.AspNetCore.Html.HtmlString Icon(string name) => new(name switch
    {
        "telegram" => """<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.9 4.3 18.7 19.4c-.2 1-.9 1.3-1.7.8l-4.8-3.5-2.3 2.2c-.3.3-.5.5-1 .5l.3-4.9 8.9-8c.4-.3-.1-.5-.6-.2L6.5 13.2 1.8 11.7c-1-.3-1-1 .2-1.5L20.6 3c.8-.3 1.6.2 1.3 1.3z"/></svg>""",
        "mail" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>""",
        "phone" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>""",
        "api" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m8 9-4 3 4 3M16 9l4 3-4 3M13.5 6l-3 12"/></svg>""",
        "db" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><ellipse cx="12" cy="6" rx="7" ry="3"/><path d="M5 6v12c0 1.7 3.1 3 7 3s7-1.3 7-3V6M5 12c0 1.7 3.1 3 7 3s7-1.3 7-3"/></svg>""",
        "bolt" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M13 3 5 14h6l-1 7 8-11h-6z"/></svg>""",
        "check" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="m5 12 5 5 9-10"/></svg>""",
        "cert" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="9" r="5"/><path d="m9 13-1.5 8L12 18.5 16.5 21 15 13"/></svg>""",
        "github" => """<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"/></svg>""",
        "linkedin" => """<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>""",
        "commit" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="3.5"/><path d="M3 12h5.5M15.5 12H21"/></svg>""",
        "download" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"/></svg>""",
        "sun" => """<svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>""",
        "moon" => """<svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg>""",
        _ => ""
    });
}

<header class="nav" id="nav">
    <div class="container nav-inner">
        <a class="logo" href="#home">@ProfileData.DisplayName</a>
        <nav class="nav-links" aria-label="@ui.NavAria">
            <a href="#stack">@ui.SectionStack</a>
            <a href="#cases">@ui.SectionCases</a>
            <a href="#experience">@ui.SectionExperience</a>
            <a href="#contact">@ui.NavContact</a>
        </nav>
        <div class="nav-tools">
            <div class="segmented" role="group" aria-label="Language">
                <a href="/" lang="ru" class="@(ui.Lang == "ru" ? "active" : null)" aria-current="@(ui.Lang == "ru" ? "page" : null)">RU</a>
                <a href="/en" lang="en" class="@(ui.Lang == "en" ? "active" : null)" aria-current="@(ui.Lang == "en" ? "page" : null)">EN</a>
            </div>
            <button type="button" class="icon-btn" id="theme-toggle" aria-label="@ui.ThemeToggle" title="@ui.ThemeToggle">@Icon("sun")@Icon("moon")</button>
        </div>
    </div>
</header>

<main>
    <section class="hero" id="home">
        <div class="container hero-grid">
            <div class="hero-text reveal">
                <span class="status"><span class="dot"></span>@ui.OpenToWork</span>
                <p class="eyebrow">@p.Role</p>
                <h1 class="display">@ProfileData.DisplayName</h1>
                <p class="lead">@p.Summary</p>
                <div class="actions">
                    <a class="btn btn-primary" href="@ProfileData.CvPath" download>@Icon("download") @ui.DownloadCv</a>
                    <a class="btn btn-secondary" href="#experience">@ui.ViewExperience</a>
                </div>
                <div class="socials">
                    <a href="@p.Contacts.GitHubUrl" target="_blank" rel="noopener" aria-label="GitHub">@Icon("github")</a>
                    <a href="@p.Contacts.LinkedInUrl" target="_blank" rel="noopener" aria-label="LinkedIn">@Icon("linkedin")</a>
                    <a href="@p.Contacts.TelegramUrl" target="_blank" rel="noopener" aria-label="Telegram">@Icon("telegram")</a>
                    <a href="mailto:@p.Contacts.Email" aria-label="Email">@Icon("mail")</a>
                    <a href="@p.Contacts.PhoneUrl" aria-label="@ui.Phone">@Icon("phone")</a>
                </div>
            </div>

            <div class="window reveal">
                <div class="window-bar">
                    <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
                    <span class="window-title">developer.xml</span>
                </div>
                <pre class="code"><span class="d">&lt;?xml version="1.0" encoding="UTF-8"?&gt;</span>
<span class="k">&lt;developer&gt;</span>
  <span class="k">&lt;name&gt;</span><span class="s">@p.FullName</span><span class="k">&lt;/name&gt;</span>
  <span class="k">&lt;role&gt;</span><span class="s">@p.Role</span><span class="k">&lt;/role&gt;</span>
  <span class="k">&lt;location&gt;</span><span class="s">@p.Location</span><span class="k">&lt;/location&gt;</span>
  <span class="k">&lt;experience&gt;</span><span class="s">@p.Experience[0].Duration</span><span class="k">&lt;/experience&gt;</span>
  <span class="k">&lt;skills&gt;</span>
    <span class="k">&lt;skill&gt;</span><span class="s">C#</span><span class="k">&lt;/skill&gt;</span>
    <span class="k">&lt;skill&gt;</span><span class="s">.NET</span><span class="k">&lt;/skill&gt;</span>
    <span class="k">&lt;skill&gt;</span><span class="s">PostgreSQL</span><span class="k">&lt;/skill&gt;</span>
    <span class="k">&lt;skill&gt;</span><span class="s">MS SQL</span><span class="k">&lt;/skill&gt;</span>
    <span class="k">&lt;skill&gt;</span><span class="s">Kafka</span><span class="k">&lt;/skill&gt;</span>
    <span class="k">&lt;skill&gt;</span><span class="s">Docker</span><span class="k">&lt;/skill&gt;</span>
  <span class="k">&lt;/skills&gt;</span>
<span class="k">&lt;/developer&gt;</span></pre>
            </div>
        </div>
    </section>

    <section class="stats" id="stats">
        <div class="container stats-grid">
            @foreach (var s in p.Stats)
            {
                <div class="stat reveal">
                    <div class="stat-value">@s.Value</div>
                    <div class="stat-label">@s.Label</div>
                </div>
            }
        </div>
    </section>

    <section class="section" id="stack">
        <div class="container">
            <h2 class="section-title reveal">@ui.SectionStack</h2>
            <div class="grid-3">
                @foreach (var g in p.SkillGroups)
                {
                    <div class="card reveal">
                        <h3 class="card-title">@g.Title</h3>
                        <div class="chips">
                            @foreach (var s in g.Items)
                            {
                                <span class="chip">@s.Name</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="section" id="expertise">
        <div class="container">
            <h2 class="section-title reveal">@ui.SectionExpertise</h2>
            <div class="grid-3">
                @foreach (var e in p.Expertise)
                {
                    <article class="card feature reveal">
                        <span class="feature-icon">@Icon(e.Icon)</span>
                        <h3 class="card-title">@e.Title</h3>
                        <p class="card-text">@e.Description</p>
                        <div class="tags">
                            @foreach (var t in e.Tags)
                            {
                                <span class="tag">@t</span>
                            }
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>

    <section class="section" id="cases">
        <div class="container">
            <h2 class="section-title reveal">@ui.SectionCases</h2>
            <div class="cases">
                @for (var i = 0; i < p.Cases.Count; i++)
                {
                    var c = p.Cases[i];
                    <article class="card case reveal">
                        <span class="case-num">@((i + 1).ToString("00"))</span>
                        <h3 class="case-title">@c.Title</h3>
                        <div class="case-grid">
                            <div class="case-problem">
                                <h4 class="case-label">@ui.CaseProblem</h4>
                                <p class="card-text">@c.Problem</p>
                            </div>
                            <div class="case-result">
                                <h4 class="case-label">@ui.CaseResult</h4>
                                <p>@c.Result</p>
                            </div>
                            <div class="case-solution">
                                <h4 class="case-label">@ui.CaseSolution</h4>
                                <ul class="list">
                                    @foreach (var s in c.Solution)
                                    {
                                        <li>@s</li>
                                    }
                                </ul>
                            </div>
                        </div>
                        <div class="tags">
                            @foreach (var t in c.Stack)
                            {
                                <span class="tag">@t</span>
                            }
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>

    <section class="section" id="experience">
        <div class="container">
            <h2 class="section-title reveal">@ui.SectionExperience</h2>
            @foreach (var j in p.Experience)
            {
                <article class="card job reveal">
                    <div class="job-head">
                        <div>
                            <h3 class="job-title">@j.Title</h3>
                            <a href="@j.CompanyUrl" target="_blank" rel="noopener" class="company">@j.Company ↗</a>
                        </div>
                        <span class="period">@j.Period · @j.Duration</span>
                    </div>
                    <p class="card-text">@j.Description</p>
                    <ul class="list two-col">
                        @foreach (var h in j.Highlights)
                        {
                            <li>@h</li>
                        }
                    </ul>
                    <div class="tags">
                        @foreach (var t in j.Tags)
                        {
                            <span class="tag">@t</span>
                        }
                    </div>
                </article>
            }
        </div>
    </section>

    @if (Model.GitHub is { } gh && gh.Days.Count > 0)
    {
        var culture = System.Globalization.CultureInfo.GetCultureInfo(ui.Lang == "en" ? "en-US" : "ru-RU");
        var byDate = gh.Days.ToDictionary(d => d.Date);
        var today = gh.Days[^1].Date;
        var from = today.AddDays(-29);
        var start = from.AddDays(-(((int)from.DayOfWeek + 6) % 7));
        var end = today.AddDays(6 - (((int)today.DayOfWeek + 6) % 7));
        var monthTotal = gh.Days.Where(d => d.Date >= from && d.Date <= today).Sum(d => d.Count);
        string[] weekdays = ui.Lang == "en"
            ? ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
            : ["Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс"];
        <section class="section" id="github">
            <div class="container">
                <h2 class="section-title reveal">@ui.SectionGitHub</h2>
                <div class="gh-grid">
                    <div class="card reveal">
                        <h3 class="card-title">@ui.GitHubMonth</h3>
                        <div class="gh-month">
                            @foreach (var w in weekdays)
                            {
                                <span class="gh-wd">@w</span>
                            }
                            @for (var date = start; date <= end; date = date.AddDays(1))
                            {
                                var inRange = date >= from && date <= today;
                                var day = byDate.GetValueOrDefault(date);
                                var level = inRange && day is not null ? day.Level : 0;
                                var title = inRange ? $"{day?.Count ?? 0} · {date.ToString("d MMMM", culture)}" : null;
                                <i class="l@(level)@(inRange ? "" : " out")@(date == today ? " today" : "")" title="@title">@date.Day</i>
                            }
                        </div>
                        <div class="gh-foot">
                            <span>@string.Format(ui.GitHubTotal, monthTotal)</span>
                            <span class="gh-legend">@ui.GitHubLess <i class="l0"></i><i class="l1"></i><i class="l2"></i><i class="l3"></i><i class="l4"></i> @ui.GitHubMore</span>
                        </div>
                    </div>
                    <div class="card reveal">
                        <h3 class="card-title">@ui.GitHubCommits</h3>
                        <ul class="rows">
                            @foreach (var c in gh.Commits)
                            {
                                <li>
                                    <span class="row-icon">@Icon("commit")</span>
                                    <div>
                                        <a class="row-title" href="@c.Url" target="_blank" rel="noopener">@c.Message</a>
                                        <div class="row-text">@c.Repo · @c.Date.ToString("d MMM yyyy", culture)</div>
                                    </div>
                                </li>
                            }
                        </ul>
                        <a class="link" href="@p.Contacts.GitHubUrl" target="_blank" rel="noopener">@ui.GitHubOpen ↗</a>
                    </div>
                </div>
            </div>
        </section>
    }

    <section class="section" id="education">
        <div class="container">
            <h2 class="section-title reveal">@ui.SectionEducation</h2>
            <div class="edu-grid">
                <div class="card reveal">
                    <h3 class="card-title">@ui.Courses</h3>
                    <ul class="rows">
                        @foreach (var ed in p.Education)
                        {
                            <li>
                                <span class="year">@ed.Year</span>
                                <div>
                                    <div class="row-title">@ed.Degree</div>
                                    <div class="row-sub">@ed.Institution</div>
                                    <div class="row-text">@ed.Details</div>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
                <div class="card reveal">
                    <h3 class="card-title">@ui.Certificates</h3>
                    <ul class="rows">
                        @foreach (var c in p.Certificates)
                        {
                            <li>
                                <span class="row-icon">@Icon("cert")</span>
                                <div>
                                    <div class="row-title">@c.Issuer @c.Title</div>
                                    <div class="row-text">@ui.DigitalCertificate · @c.Year</div>
                                </div>
                            </li>
                        }
                        <li>
                            <span class="row-icon ok">@Icon("check")</span>
                            <div>
                                <div class="row-title">@ui.DegreeTitle</div>
                                <div class="row-text">@ui.DegreeText</div>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <section class="section" id="principles">
        <div class="container">
            <h2 class="section-title reveal">@ui.SectionPrinciples</h2>
            <div class="grid-3">
                @foreach (var pr in p.Principles)
                {
                    <figure class="card principle reveal">
                        <span class="principle-badge" style="--c:@pr.Color">@pr.Initials</span>
                        <h3 class="card-title">@pr.Title</h3>
                        <blockquote class="card-text">@pr.Text</blockquote>
                    </figure>
                }
            </div>
        </div>
    </section>

    <section class="section" id="languages">
        <div class="container">
            <h2 class="section-title reveal">@ui.SectionLanguages</h2>
            <div class="grid-3">
                @foreach (var l in p.Languages)
                {
                    <article class="card lang reveal">
                        <div class="lang-head">
                            <h3 class="card-title">@l.Name</h3>
                            <span class="lang-code">@l.Code</span>
                        </div>
                        <p class="card-text">@l.Level</p>
                        <div class="meter" role="meter" aria-valuenow="@l.Percent" aria-valuemin="0" aria-valuemax="100" aria-label="@l.Name">
                            <span style="width:@(l.Percent)%"></span>
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>

    <section class="section contact" id="contact">
        <div class="container">
            <div class="contact-card reveal">
                <h2 class="contact-title">@ui.ContactTitle</h2>
                <p class="lead">@p.WorkPreferences</p>
                <ul class="contact-list">
                    <li><span class="k">@ui.Phone</span><a href="@p.Contacts.PhoneUrl">@p.Contacts.Phone</a><span class="note">@ui.PreferredContact</span></li>
                    <li><span class="k">Telegram</span><a href="@p.Contacts.TelegramUrl" target="_blank" rel="noopener">@p.Contacts.Telegram</a></li>
                    <li><span class="k">Email</span><a href="mailto:@p.Contacts.Email">@p.Contacts.Email</a></li>
                    <li><span class="k">GitHub</span><a href="@p.Contacts.GitHubUrl" target="_blank" rel="noopener">@Contacts.Display(p.Contacts.GitHubUrl)</a></li>
                    <li><span class="k">LinkedIn</span><a href="@p.Contacts.LinkedInUrl" target="_blank" rel="noopener">@Contacts.Display(p.Contacts.LinkedInUrl)</a></li>
                </ul>
                <div class="actions">
                    <a class="btn btn-primary" href="@p.Contacts.TelegramUrl" target="_blank" rel="noopener">@Icon("telegram") @ui.SendMessage</a>
                    <a class="btn btn-secondary" href="@ProfileData.CvPath" download>@Icon("download") @ui.DownloadCv</a>
                </div>
            </div>
        </div>
    </section>
</main>

<footer class="footer">
    <div class="container">© @DateTime.Now.Year @ProfileData.DisplayName · sozakbay.dev</div>
</footer>

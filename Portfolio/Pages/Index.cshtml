@page
@model IndexModel
@{
    var p = Model.Profile;
    ViewData["Title"] = $"{p.ShortName} — {p.Role}";
    ViewData["Description"] = p.Summary;
    var sectionNo = 0;
    string Num() => (++sectionNo).ToString("00") + ".";
}

@functions {
    static Microsoft.AspNetCore.Html.HtmlString Icon(string name) => new(name switch
    {
        "telegram" => """<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.9 4.3 18.7 19.4c-.2 1-.9 1.3-1.7.8l-4.8-3.5-2.3 2.2c-.3.3-.5.5-1 .5l.3-4.9 8.9-8c.4-.3-.1-.5-.6-.2L6.5 13.2 1.8 11.7c-1-.3-1-1 .2-1.5L20.6 3c.8-.3 1.6.2 1.3 1.3z"/></svg>""",
        "mail" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>""",
        "phone" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>""",
        "api" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m8 9-4 3 4 3M16 9l4 3-4 3M13.5 6l-3 12"/></svg>""",
        "db" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><ellipse cx="12" cy="6" rx="7" ry="3"/><path d="M5 6v12c0 1.7 3.1 3 7 3s7-1.3 7-3V6M5 12c0 1.7 3.1 3 7 3s7-1.3 7-3"/></svg>""",
        "bolt" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M13 3 5 14h6l-1 7 8-11h-6z"/></svg>""",
        "check" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="m5 12 5 5 9-10"/></svg>""",
        "cert" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="9" r="5"/><path d="m9 13-1.5 8L12 18.5 16.5 21 15 13"/></svg>""",
        "arrow" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"/></svg>""",
        _ => ""
    });
}

<header class="nav">
    <div class="container nav-inner">
        <a class="logo" href="#home"><span class="accent">&gt;_</span> @p.ShortName.ToLowerInvariant()</a>
        <nav class="nav-links" aria-label="Навигация">
            <a href="#home" class="active">~/home</a>
            <a href="#stack">~/stack</a>
            <a href="#experience">~/experience</a>
            <a href="#contact">~/contact</a>
        </nav>
        <div class="nav-icons">
            <a href="@p.Contacts.TelegramUrl" target="_blank" rel="noopener" aria-label="Telegram">@Icon("telegram")</a>
            <a href="mailto:@p.Contacts.Email" aria-label="Email">@Icon("mail")</a>
        </div>
    </div>
</header>

<main>
    <section class="hero" id="home">
        <div class="container hero-grid">
            <div class="hero-text reveal">
                <span class="status"><span class="dot"></span> open to work</span>
                <h1>
                    <span class="kw">var</span> <span class="muted-strong">developer</span> <span class="kw">=</span><br />
                    <span class="str">"@p.ShortName"</span><span class="kw">;</span>
                </h1>
                <p class="role"><span class="comment">//</span> @p.Role · @p.Tagline</p>
                <p class="lead">@p.Summary</p>
                <div class="hero-actions">
                    <a class="btn btn-primary" href="#experience">$ view --experience</a>
                    <a class="btn btn-ghost" href="#contact">$ contact --email</a>
                </div>
                <div class="socials">
                    <a href="@p.Contacts.TelegramUrl" target="_blank" rel="noopener" aria-label="Telegram">@Icon("telegram")</a>
                    <a href="mailto:@p.Contacts.Email" aria-label="Email">@Icon("mail")</a>
                    <a href="@p.Contacts.PhoneUrl" aria-label="Телефон">@Icon("phone")</a>
                </div>
            </div>

            <div class="terminal reveal">
                <div class="term-bar">
                    <span class="lights"><i></i><i></i><i></i></span>
                    <span class="term-title">eldos@@astana: ~</span>
                </div>
                <pre class="term-body" id="about-json"><span class="prompt">$</span> cat about.json
{
  <span class="k">"name"</span>: <span class="s">"@p.FullName"</span>,
  <span class="k">"role"</span>: <span class="s">"@p.Role"</span>,
  <span class="k">"location"</span>: <span class="s">"@p.Location"</span>,
  <span class="k">"experience"</span>: <span class="s">"@p.Experience[0].Duration"</span>,
  <span class="k">"skills"</span>: [
    <span class="s">"C#"</span>, <span class="s">".NET"</span>, <span class="s">"PostgreSQL"</span>,
    <span class="s">"MS SQL"</span>, <span class="s">"Kafka"</span>, <span class="s">"Docker"</span>
  ]
}

<span class="prompt">$</span> <span class="cursor">_</span></pre>
            </div>
        </div>
        <a class="scroll-hint" href="#stats" aria-label="Прокрутить вниз">@Icon("arrow")</a>
    </section>

    <section class="stats" id="stats">
        <div class="container stats-grid">
            @foreach (var s in p.Stats)
            {
                <div class="stat reveal">
                    <div class="stat-value">@s.Value</div>
                    <div class="stat-label">@s.Label</div>
                </div>
            }
        </div>
    </section>

    <section class="section" id="stack">
        <div class="container">
            <h2 class="section-title"><span class="num">@Num()</span> Стек технологий</h2>
            <div class="grid-3">
                @foreach (var g in p.SkillGroups)
                {
                    <div class="card reveal">
                        <h3 class="card-label"><span class="bullet @g.Dot"></span>@g.Title</h3>
                        <div class="chips">
                            @foreach (var s in g.Items)
                            {
                                <span class="chip"><span class="chip-badge" style="--c:@s.Color">@s.Badge</span>@s.Name</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="section" id="expertise">
        <div class="container">
            <h2 class="section-title"><span class="num">@Num()</span> Экспертиза</h2>
            <div class="grid-3">
                @foreach (var e in p.Expertise)
                {
                    <article class="card project reveal">
                        <div class="project-head">
                            <span class="project-name">@Icon(e.Icon) @e.Title</span>
                            <span class="project-tag">@e.Tag</span>
                        </div>
                        <p class="card-text">@e.Description</p>
                        <div class="tags">
                            @foreach (var t in e.Tags)
                            {
                                <span class="tag">@t</span>
                            }
                        </div>
                    </article>
                }
            </div>
            <div class="center"><a class="btn btn-ghost small" href="#contact">$ cat ./resume</a></div>
        </div>
    </section>

    <section class="section" id="experience">
        <div class="container">
            <h2 class="section-title"><span class="num">@Num()</span> Опыт работы</h2>
            <ol class="timeline">
                @foreach (var j in p.Experience)
                {
                    <li class="timeline-item reveal">
                        <div class="timeline-head">
                            <h3>
                                @j.Title <span class="at">@@</span>
                                <a href="@j.CompanyUrl" target="_blank" rel="noopener" class="company">@j.Company</a>
                            </h3>
                            <span class="period">@j.Period · @j.Duration</span>
                        </div>
                        <p class="card-text">@j.Description</p>
                        <ul class="highlights">
                            @foreach (var h in j.Highlights)
                            {
                                <li>@h</li>
                            }
                        </ul>
                        <div class="tags">
                            @foreach (var t in j.Tags)
                            {
                                <span class="tag">@t</span>
                            }
                        </div>
                    </li>
                }
            </ol>
        </div>
    </section>

    <section class="section" id="education">
        <div class="container">
            <h2 class="section-title"><span class="num">@Num()</span> Образование</h2>
            <div class="edu-grid">
                <div class="card reveal">
                    <div class="card-cmd">$ git log --education</div>
                    <ul class="edu-list">
                        @foreach (var ed in p.Education)
                        {
                            <li>
                                <span class="edu-year">@ed.Year</span>
                                <div>
                                    <div class="edu-degree">@ed.Degree</div>
                                    <div class="edu-inst">@ed.Institution</div>
                                    <div class="edu-details">@ed.Details</div>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
                <div class="card reveal">
                    <div class="card-cmd">$ ls ./certificates</div>
                    <ul class="activity">
                        @foreach (var c in p.Certificates)
                        {
                            <li>
                                <span class="activity-icon">@Icon("cert")</span>
                                <div>
                                    <div class="activity-title">@c.Issuer @c.Title</div>
                                    <div class="activity-text">Электронный сертификат · @c.Year</div>
                                </div>
                            </li>
                        }
                        <li>
                            <span class="activity-icon ok">@Icon("check")</span>
                            <div>
                                <div class="activity-title">Прикладная информатика</div>
                                <div class="activity-text">Высшее профильное образование + международные сертификации Cisco</div>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <section class="section" id="principles">
        <div class="container">
            <h2 class="section-title"><span class="num">@Num()</span> Как я работаю</h2>
            <div class="grid-3">
                @foreach (var pr in p.Principles)
                {
                    <figure class="card quote reveal">
                        <div class="quote-mark">“</div>
                        <blockquote class="card-text">@pr.Text</blockquote>
                        <figcaption>
                            <span class="avatar" style="--c:@pr.Color">@pr.Initials</span>
                            <span>
                                <span class="quote-name">@pr.Title</span>
                                <span class="quote-role">ООП · SOLID · Agile/Scrum</span>
                            </span>
                        </figcaption>
                    </figure>
                }
            </div>
        </div>
    </section>

    <section class="section" id="languages">
        <div class="container">
            <h2 class="section-title"><span class="num">@Num()</span> Языки</h2>
            <div class="grid-3">
                @foreach (var l in p.Languages)
                {
                    <article class="card lang reveal">
                        <span class="pill">@l.Code</span>
                        <h3 class="lang-name">@l.Name</h3>
                        <p class="card-text">@l.Level</p>
                        <div class="meter" role="meter" aria-valuenow="@l.Percent" aria-valuemin="0" aria-valuemax="100" aria-label="@l.Name">
                            <span style="width:@(l.Percent)%"></span>
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>

    <section class="section contact" id="contact">
        <div class="container">
            <div class="terminal contact-card reveal">
                <div class="term-bar">
                    <span class="lights"><i></i><i></i><i></i></span>
                    <span class="term-title">contact</span>
                </div>
                <div class="contact-body">
                    <h2><span class="accent">&gt;</span> Давайте работать вместе</h2>
                    <p class="card-text">@p.WorkPreferences</p>
                    <ul class="contact-list">
                        <li><span class="k">telegram</span> <a href="@p.Contacts.TelegramUrl" target="_blank" rel="noopener">@p.Contacts.Telegram</a> <span class="muted">— предпочитаемый способ связи</span></li>
                        <li><span class="k">email</span> <a href="mailto:@p.Contacts.Email">@p.Contacts.Email</a></li>
                        <li><span class="k">phone</span> <a href="@p.Contacts.PhoneUrl">@p.Contacts.Phone</a></li>
                    </ul>
                    <a class="btn btn-primary" href="@p.Contacts.TelegramUrl" target="_blank" rel="noopener">$ send --message</a>
                </div>
            </div>
        </div>
    </section>
</main>

<footer class="footer">
    <div class="container">
        <span class="accent">&gt;_</span> @p.ShortName.ToLowerInvariant() — built with C# &amp; ASP.NET Core · @DateTime.Now.Year
    </div>
</footer>
